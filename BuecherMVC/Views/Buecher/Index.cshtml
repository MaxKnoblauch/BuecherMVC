@model BuecherMVC.Models.BuecherListeModel

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h2>Aktuelle Bücher</h2>

            @if (Model.AktuelleBuecher != null && Model.AktuelleBuecher.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Titel</th>
                                <th>Autor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var buch in Model.AktuelleBuecher)
                            {
                                <tr>
                                    <td>@buch.Id</td>
                                    <td>@buch.Titel</td>
                                    <td>@buch.Autor</td>
                                    <td>
                                        <form asp-controller="Buecher" asp-action="VerschiebeZuArchiviertenBuechern" method="post">
                                            <input type="hidden" name="id" value="@buch.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm archivieren-btn" style="background-color: blue; color: white;">
                                                Archivieren <i class="fas fa-arrow-right"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>Keine aktuellen Bücher gefunden.</p>
            }
        </div>

        <div class="col-md-6">
            <h2>Archivierte Bücher</h2>

            @if (Model.ArchivierteBuecher != null && Model.ArchivierteBuecher.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Titel</th>
                                <th>Autor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var buch in Model.ArchivierteBuecher)
                            {
                                <tr>
                                    <td>@buch.Id</td>
                                    <td>@buch.Titel</td>
                                    <td>@buch.Autor</td>
                                    <td>
                                        <form asp-controller="Buecher" asp-action="VerschiebeZuAktuellenBuechern" method="post">
                                            <input type="hidden" name="id" value="@buch.Id" />
                                            <button type="submit" class="btn btn-success btn-sm dearchivieren-btn" style="background-color: green; color: white;">
                                                Dearchivieren <i class="fas fa-arrow-left"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>Keine archivierten Bücher gefunden.</p>
            }
        </div>
    </div>
</div>
