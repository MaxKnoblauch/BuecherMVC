@model BuecherMVC.Models.BuecherListeModel // Bindet das ViewModel BuecherListeModel an die View

<div class="container">
    <div class="row">
        <!-- Linke Spalte für aktuelle Bücher -->
        <div class="col-md-6">
            <h2>Aktuelle Buecher</h2>

            @* Überprüft, ob die Liste der aktuellen Bücher nicht null und nicht leer ist *@
            @if (Model.AktuelleBuecher != null && Model.AktuelleBuecher.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Titel</th>
                                <th>Autor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Schleife durch jedes Buch in der Liste der aktuellen Bücher *@
                            @foreach (var buch in Model.AktuelleBuecher)
                            {
                                <tr>
                                    <td>@buch.Id</td> <!-- Buch Id -->
                                    <td>@buch.Titel</td> <!-- Buch Titel -->
                                    <td>@buch.Autor</td> <!-- Buch Autor -->
                                    <td>
                                        @* Formular zum Verschieben eines Buches zu den archivierten Büchern *@
                                        <form asp-controller="Buecher" asp-action="VerschiebeZuArchiviertenBuechern" method="post">
                                            <input type="hidden" name="id" value="@buch.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm archivieren-btn" style="background-color: blue; color: white;">
                                                zu archivierten Buechern verschieben <i class="fas fa-arrow-right"></i> <!-- Button zum Verschieben -->
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>Keine aktuellen Bücher gefunden.</p> <!-- Nachricht, wenn keine aktuellen Bücher vorhanden sind -->
            }
        </div>

        <!-- Rechte Spalte für archivierte Bücher -->
        <div class="col-md-6">
            <h2>Archivierte Buecher</h2>

            @* Überprüft, ob die Liste der archivierten Bücher nicht null und nicht leer ist *@
            @if (Model.ArchivierteBuecher != null && Model.ArchivierteBuecher.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Titel</th>
                                <th>Autor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Schleife durch jedes Buch in der Liste der archivierten Bücher *@
                            @foreach (var buch in Model.ArchivierteBuecher)
                            {
                                <tr>
                                    <td>@buch.Id</td> <!-- Buch Id -->
                                    <td>@buch.Titel</td> <!-- Buch Titel -->
                                    <td>@buch.Autor</td> <!-- Buch Autor -->
                                    <td>
                                        @* Formular zum Verschieben eines Buches zu den aktuellen Büchern *@
                                        <form asp-controller="Buecher" asp-action="VerschiebeZuAktuellenBuechern" method="post">
                                            <input type="hidden" name="id" value="@buch.Id" />
                                            <button type="submit" class="btn btn-success btn-sm dearchivieren-btn" style="background-color: green; color: white;">
                                                zu aktuellen Buechern verschieben <i class="fas fa-arrow-left"></i> <!-- Button zum Verschieben -->
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>Keine archivierten Bücher gefunden.</p> <!-- Nachricht, wenn keine archivierten Bücher vorhanden sind -->
            }
        </div>
    </div>
</div>
